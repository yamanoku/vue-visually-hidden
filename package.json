{
  "name": "vue-visually-hidden",
  "description": "Vue.js visually hidden component",
  "version": "2.0.1",
  "keywords": [
    "vue",
    "vue.js",
    "vue3",
    "component",
    "accessible",
    "accessibility",
    "a11y",
    "visually hidden",
    "visually hidden component",
    "sr-only",
    "screenreader"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "demo:dev": "cd demo && vite",
    "demo:build": "cd demo && vite build",
    "test": "vitest run"
  },
  "types": "src/index.ts",
  "type": "module",
  "module": "./dist/vue-visually-hidden.js",
  "main": "./dist/vue-visually-hidden.umd.js",
  "files": [
    "dist",
    "src/index.ts",
    "src/components/*"
  ],
  "exports": {
    ".": {
      "import": "./dist/vue-visually-hidden.js",
      "require": "./dist/vue-visually-hidden.umd.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yamanoku/vue-visually-hidden.git"
  },
  "author": "yamanoku",
  "bugs": {
    "url": "https://github.com/yamanoku/vue-visually-hidden/issues"
  },
  "homepage": "https://github.com/yamanoku/vue-visually-hidden#readme",
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/preset-env": "8.0.2",
    "@types/jest": "30.0.0",
    "@types/jest-axe": "3.5.9",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/compiler-sfc": "3.5.40",
    "@vue/test-utils": "2.4.11",
    "jest-axe": "11.0.0",
    "jsdom": "30.0.1",
    "tslib": "2.8.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vite-plugin-lib-inject-css": "2.2.2",
    "vitest": "4.1.10",
    "vue": "3.5.40",
    "vue-tsc": "3.3.8"
  },
  "license": "MIT"
}
